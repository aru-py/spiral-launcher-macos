										<string></string>
										<key>Source</key>
										<string>Nothing</string>
										<key>Text</key>
										<string>jq -r '["name","url"], (.. | objects | select(.type == "url") | [.name, .url]) | @csv' \
  "$HOME/Library/Application Support/Google/Chrome/Default/Bookmarks" \
| awk -F'[][]' 'NF&gt;1 { tag=$2; sub(/ ?\[[^]]*\]/, "", $0); print tag "," $0 }'</string>
										<key>TimeOutAbortsMacro</key>
										<true/>
