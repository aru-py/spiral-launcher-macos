												<string>CustomPrompt</string>
												<key>Text</key>
												<string>&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
    &lt;meta charset="utf-8"&gt;
    &lt;style&gt;
        :root {
            --bg: #ffffff;
            --fg: #1a1a1a;
            --dim: #8a8a8a;
            --sel: #e8e8e8;
            --tag: #805FAA;
            --rule: #e5e5e5;
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #232323;
                --fg: #f0f0f0;
                --dim: #888888;
                --sel: #3a3a3a;
                --tag: #805FAA;
                --rule: #383838;
            }
        }


        html {
            background: transparent;
            border-radius: 20px;
        }

        #list::-webkit-scrollbar {
            display: none;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            overflow: hidden;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--fg);
            font: 15px/1.4 -apple-system, BlinkMacSystemFont, sans-serif;
            overflow: hidden;
            border-radius: 20px;
            padding: 10px 0;
        }

        body {
            display: flex;
            flex-direction: column;
        }


        #bar {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 18px;
            border-bottom: 1px solid var(--rule);
        }

        #icon {
            flex: none;
            width: 26px;
            height: 26px;
            object-fit: contain;
            image-rendering: -webkit-optimize-contrast;
        }

        #q {
            flex: 1;
            min-width: 0;
            padding: 0;
            border: none;
            outline: none;
            background: transparent;
            color: inherit;
            font: 22px -apple-system, BlinkMacSystemFont, sans-serif;
        }

        #list {
            list-style: none;
            margin: 0;
            padding: 4px 0;
            max-height: 360px;
            overflow-y: auto;
        }

        #list {
            flex: 1;
            min-height: 0;
            max-height: none;
        }

        #list li {
            display: flex;
            align-items: baseline;
            gap: 12px;
            padding: 7px 18px;
            cursor: default;
            white-space: nowrap;
        }

        #list li.on {
            background: var(--sel);
        }

        .tag {
            flex: none;
            min-width: 3.5ch;
            color: white;
            font-family: 'Menlo', monospace;
            font-size: 10px;
            border-radius: 4px;
            padding: 4px 4px;
            background: var(--tag);
        }

        #list li { align-items: center; }


        #list li.on .tag {
            font-weight: 600;
        }

        .name {
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #empty {
            padding: 14px 18px;
            color: var(--dim);
        }
    &lt;/style&gt;
&lt;/head&gt;
&lt;body data-kmwindow="SCREEN(Main,Left,50%)-320,SCREEN(Main,Top,25%),640,250"&gt;


&lt;div id="bar"&gt;&lt;img alt=""
                   id="icon"
                   src="data:image/png;base64,"&gt; &lt;input autocomplete="off" id="q" placeholder="Spell" spellcheck="false" type="text"&gt;&lt;/div&gt;

&lt;ul id="list"&gt;&lt;/ul&gt;
&lt;div hidden id="empty"&gt;No match&lt;/div&gt;

&lt;script&gt;

    var done = false;

    window.addEventListener('blur', function () {
        if (done) return;
        done = true;
        if (window.KeyboardMaestro) window.KeyboardMaestro.Cancel('Cancel');
    });

    var DIRECT_OPEN = true;
    var BOOKMARKS = [
        {tag: 'goo', name: 'Google', url: 'https://www.google.com'},
        {tag: 'ama', name: 'Amazon', url: 'https://www.amazon.com'},
        {tag: 'git', name: 'GitHub', url: 'https://github.com'},
        {tag: 'cla', name: 'Claude', url: 'https://claude.ai'},
        {tag: 'spo', name: 'Spotify', url: 'https://open.spotify.com'},
    ];

    var q = document.getElementById('q');
    var list = document.getElementById('list');
    var empty = document.getElementById('empty');
    var shown = [];
    var cursor = 0;

    // Exact tag first, then tag prefix, then name substring. Lower sorts first.
    function score(item, needle) {
        var tag = item.tag.toLowerCase();
        var name = item.name.toLowerCase();
        if (tag === needle) return 0;
        if (tag.indexOf(needle) === 0) return 1;
        if (name.indexOf(needle) === 0) return 2;
        if (name.indexOf(needle) !== -1) return 3;
        if (tag.indexOf(needle) !== -1) return 4;
        return -1;
    }

    function render() {
        var needle = q.value.trim().toLowerCase();

        if (needle === '') {
            shown = BOOKMARKS.slice();
        } else {
            shown = BOOKMARKS
                .map(function (item) {
                    return {item: item, s: score(item, needle)};
                })
                .filter(function (r) {
                    return r.s !== -1;
                })
                .sort(function (a, b) {
                    return a.s - b.s;
                })
                .map(function (r) {
                    return r.item;
                });
        }

        cursor = 0;
        list.innerHTML = '';
        shown.forEach(function (item, i) {
            var li = document.createElement('li');
            if (i === 0) li.className = 'on';

            var t = document.createElement('span');
            t.className = 'tag';
            t.textContent = item.tag;

            var n = document.createElement('span');
            n.className = 'name';
            n.textContent = item.name;

            li.appendChild(t);
            li.appendChild(n);
            li.addEventListener('click', function () {
                choose(item);
            });
            list.appendChild(li);
        });

        empty.hidden = shown.length &gt; 0;

        var hit = BOOKMARKS.filter(function (b) {
            return b.tag.toLowerCase() === needle;
        });
        var ambiguous = BOOKMARKS.some(function (b) {
            var t = b.tag.toLowerCase();
            return t !== needle &amp;&amp; t.indexOf(needle) === 0;
        });
        if (hit.length === 1 &amp;&amp; !ambiguous) choose(hit[0], true);
    }

    function move(delta) {
        if (!shown.length) return;
        var rows = list.children;
        rows[cursor].classList.remove('on');
        cursor = (cursor + delta + shown.length) % shown.length;
        rows[cursor].classList.add('on');
        rows[cursor].scrollIntoView({block: 'nearest'});
    }

    var navigated = false;

    function choose(item) {
        if (!item) return;


        var km = window.KeyboardMaestro;
        if (km) km.SetVariable('url', item.url);

        if (DIRECT_OPEN) {
            window.location.href = item.url;
        }

        if (km) km.Submit('OK');
        else console.log('would open:', item.url); // standalone preview
    }

    q.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown' || (e.key === 'n' &amp;&amp; e.ctrlKey)) {
            e.preventDefault();
            move(1);
        } else if (e.key === 'ArrowUp' || (e.key === 'p' &amp;&amp; e.ctrlKey)) {
            e.preventDefault();
            move(-1);
        } else if (e.key === 'Enter') {
            e.preventDefault();
            choose(shown[cursor]);
        } else if (e.key === 'Escape' || (e.key === '.' &amp;&amp; e.metaKey)) {
            e.preventDefault();
            if (window.KeyboardMaestro) window.KeyboardMaestro.Cancel('Cancel');
        }
    });

    q.addEventListener('input', render);

    

    // KM calls this once the window is up.
    function KMInit() {
        var raw = window.KeyboardMaestro.GetVariable('bookmarkList');
        if (raw) {
            BOOKMARKS = raw.split('\n').filter(Boolean).map(function (line) {
                var p = line.split(',');
                return {tag: p[0], name: p[1].replace(/["']/g, ''), url: p[2].replace(/["']/g, '')};
            });
        }
        render();
        q.focus();
    }

    render();
&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</string>
